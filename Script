local function buildFallbackFigure()
	local model = Instance.new("Model")
	model.Name = "Figure"

	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model

	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.BrickColor = BrickColor.new("Really black")
	torso.Material = Enum.Material.SmoothPlastic
	torso.Parent = model

	local head = Instance.new("Part")
	head.Name = "Head"
	head.Shape = Enum.PartType.Ball
	head.Size = Vector3.new(1.4, 1.4, 1.4)
	head.BrickColor = BrickColor.new("Really black")
	head.Material = Enum.Material.SmoothPlastic
	head.Parent = model

	local weld = Instance.new("WeldConstraint")
	weld.Part0 = torso
	weld.Part1 = head
	weld.Parent = torso
	head.CFrame = torso.CFrame * CFrame.new(0, 1.6, 0)

	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	root.Parent = model

	model.PrimaryPart = root
	return model
end

local function buildFigure(userId)
	local ok, model = pcall(function()
		return Players:CreateHumanoidModelFromUserId(userId)
	end)
	if not ok or not model then
		return buildFallbackFigure()
	end

	model.Name = "Figure"

	-- Strip anything human-looking, paint it black
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then
			d.BrickColor   = BrickColor.new("Really black")
			d.Material     = Enum.Material.SmoothPlastic
			d.Transparency = 0
			d.CanCollide   = true
		elseif d:IsA("Decal") or d:IsA("Texture") or d:IsA("Accessory")
			or d:IsA("Shirt") or d:IsA("Pants") or d:IsA("ShirtGraphic") then
			d:Destroy()
		end
	end

	if not model.PrimaryPart then
		model.PrimaryPart = model:FindFirstChild("HumanoidRootPart")
	end
	return model
end

local function spawnMonster(userId)
	local spawnPos = randomAroundPlayer(CONFIG.RelocateMin, CONFIG.RelocateMax)
	if not spawnPos then return nil end

	local model = buildFigure(userId)
	if not model then return nil end

	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.MaxHealth = math.huge
		humanoid.Health    = math.huge
		humanoid.WalkSpeed = CONFIG.MonsterSpeed
		humanoid.JumpPower = 0
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		humanoid.BreakJointsOnDeath  = false
	end

	local ground = findGround(spawnPos) or spawnPos
	local root = model.PrimaryPart or model:FindFirstChild("HumanoidRootPart")
	if root then
		model:PivotTo(CFrame.new(ground + Vector3.new(0, 3, 0)))
	end

	model.Parent = Workspace
	track(model)

	-- Footstep / presence audio
	local static = newSound(CONFIG.Sounds.Static, 0, true, model.PrimaryPart or model)
	static:Play()
	model:SetAttribute("StaticSound", static)

	return model
end

local function relocateMonster(model)
	local pos = randomAroundPlayer(CONFIG.RelocateMin, CONFIG.RelocateMax)
	if not pos then return end
	local ground = findGround(pos, { model }) or pos
	model:PivotTo(CFrame.new(ground + Vector3.new(0, 3, 0)))
end

