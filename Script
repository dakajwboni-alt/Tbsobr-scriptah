--======================  3. FLASHLIGHT TOOL  =========================
local function giveFlashlight()
	local backpack = LP:FindFirstChildOfClass("Backpack")
	if not backpack then return end

	local tool = Instance.new("Tool")
	tool.Name           = "Flashlight"
	tool.RequiresHandle = false
	tool.CanBeDropped   = false
	tool.ToolTip        = "Left-click or press F to toggle"
	tool.Parent         = backpack
	track(tool)

	local state = { on = false, battery = 100, light = nil }

	local function setLight(on)
		local char = LP.Character
		local head = char and char:FindFirstChild("Head")
		if not head then return end

		if on and not state.light then
			local spot = Instance.new("SpotLight")
			spot.Name       = "HorrorFlashlight"
			spot.Angle      = 42
			spot.Brightness = 2.6
			spot.Range      = 55
			spot.Face       = Enum.NormalId.Front
			spot.Color      = Color3.fromRGB(255, 246, 220)
			spot.Parent     = head
			state.light = spot
		elseif not on and state.light then
			state.light:Destroy()
			state.light = nil
		end
		state.on = on
	end

	tool.Equipped:Connect(function()
		if state.battery > 0 then setLight(true) end
	end)
	tool.Unequipped:Connect(function()
		setLight(false)
	end)
	tool.Activated:Connect(function()
		if state.battery <= 0 then return end
		setLight(not state.on)
	end)

	-- F key toggles while equipped
	UserInputService.InputBegan:Connect(function(input, processed)
		if processed then return end
		if input.KeyCode == Enum.KeyCode.F and tool.Parent == LP.Character then
			if state.battery <= 0 then return end
			setLight(not state.on)
		end
	end)

	-- Battery drain + flicker when a monster is near
	task.spawn(function()
		while Horror.running do
			task.wait(0.1)
			if state.on and state.battery > 0 then
				state.battery = math.max(0, state.battery - CONFIG.BatteryDrain * 0.1)
				if state.battery <= 0 then setLight(false) end

				local nearest = math.huge
				for _, m in ipairs(Horror.monsters) do
					local root = m:FindFirstChild("HumanoidRootPart")
					local char = LP.Character
					local hrp  = char and char:FindFirstChild("HumanoidRootPart")
					if root and hrp then
						nearest = math.min(nearest, (root.Position - hrp.Position).Magnitude)
					end
				end

				if state.light then
					if nearest < 35 then
						-- panic flicker
						state.light.Enabled = math.random() > 0.35
						state.light.Brightness = 1.6 + math.random() * 1.6
					else
						state.light.Enabled = true
						state.light.Brightness = 2.6
					end
				end
			end
		end
	end)

	-- Auto-equip once
	task.defer(function()
		local char = LP.Character or LP.CharacterAdded:Wait()
		task.wait(0.5)
		local humanoid = char:FindFirstChildOfClass("Humanoid")
		if humanoid and tool.Parent == backpack then
			humanoid:EquipTool(tool)
		end
	end)

	Horror.flashlight = state
end

