--======================  7. GOLD KEY  ================================
local function spawnKey()
	local candidates = {}
	for _, d in ipairs(Workspace:GetDescendants()) do
		if d:IsA("BasePart")
			and d.Anchored
			and d.CanCollide
			and d.Size.Magnitude > 3
			and d.Position.Y > -40
			and d.Position.Y < 800
		then
			table.insert(candidates, d)
		end
	end

	local key = Instance.new("Part")
	key.Name         = "GoldKey"
	key.Size         = Vector3.new(1.2, 1.2, 0.4)
	key.BrickColor   = BrickColor.new("Gold")
	key.Material     = Enum.Material.Neon
	key.Anchored     = true
	key.CanCollide   = false
	key.Shape        = Enum.PartType.Cylinder

	local glow = Instance.new("PointLight")
	glow.Brightness = 3
	glow.Range      = 22
	glow.Color      = Color3.fromRGB(255, 215, 90)
	glow.Parent     = key

	if #candidates > 0 then
		local base = candidates[math.random(1, #candidates)]
		local ground = findGround(base.Position, { key }) or (base.Position + Vector3.new(0, 3, 0))
		key.CFrame = CFrame.new(ground + Vector3.new(0, 2.5, 0))
	else
		-- No usable geometry: drop it somewhere near the player instead
		local pos = randomAroundPlayer(40, 90) or Vector3.new(0, 20, 0)
		local ground = findGround(pos, { key }) or pos
		key.CFrame = CFrame.new(ground + Vector3.new(0, 3, 0))
	end

	key.Parent = Workspace
	track(key)

	-- Slow spin so it catches the eye
	task.spawn(function()
		while key.Parent and Horror.running do
			key.CFrame = key.CFrame * CFrame.Angles(0, math.rad(2), 0)
			task.wait(0.03)
		end
	end)

	return key
end

--======================  8. SHUTDOWN  ================================
local function stopHorror(survived)
	if not Horror.running and not survived then return end
	Horror.running = false

	-- Restore lighting
	local b = Horror.lightingBackup
	if b.ClockTime then
		Lighting.ClockTime      = b.ClockTime
		Lighting.Brightness     = b.Brightness
		Lighting.FogEnd         = b.FogEnd
		Lighting.FogStart       = b.FogStart
		Lighting.Ambient        = b.Ambient
		Lighting.OutdoorAmbient = b.OutdoorAmbient
	end

	for _, inst in ipairs(Horror.instances) do
		pcall(function()
			if inst and inst.Parent then inst:Destroy() end
		end)
	end
	Horror.instances = {}
	Horror.monsters  = {}

	if survived then
		local gui = Instance.new("ScreenGui")
		gui.IgnoreGuiInset = true
		gui.Parent = PGui

		local label = Instance.new("TextLabel")
		label.Size = UDim2.fromScale(1, 1)
		label.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextSize = 46
		label.TextColor3 = Color3.fromRGB(255, 215, 90)
		label.Text = "YOU ESCAPED"
		label.TextTransparency = 1
		label.Parent = gui

		TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 0 }):Play()
		task.delay(3, function()
			TweenService:Create(label, TweenInfo.new(1), { TextTransparency = 1 }):Play()
			task.wait(1.2)
			gui:Destroy()
		end)
	end
end

--======================  9. MAIN LOOP  ===============================
local function start()
	applyAtmosphere()
	startAmbience()
	giveFlashlight()

	for i = 1, CONFIG.MonsterCount do
		local id = CONFIG.MonsterUserIds[((i - 1) % #CONFIG.MonsterUserIds) + 1]
		local m  = spawnMonster(id)
		if m then table.insert(Horror.monsters, m) end
	end

	local key = spawnKey()
	task.delay(CONFIG.KeyHintDelay, function()
		if Horror.running then
			makePopup("A GOLD KEY HAS APPEARED SOMEWHERE", 3)
		end
	end)

	-- Heartbeat: monster AI, key pickup, proximity audio
	local monsterAccum = 0
	RunService.Heartbeat:Connect(function(dt)
		if not Horror.running then return end

		monsterAccum += dt
		if monsterAccum < 0.15 then return end
		monsterAccum = 0

		local char = LP.Character
		local hrp  = char and char:FindFirstChild("HumanoidRootPart")
		if not hrp then return end

		local nearest = math.huge

		for _, m in ipairs(Horror.monsters) do
			if not m.Parent then continue end
			local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
			local hum  = m:FindFirstChildOfClass("Humanoid")
			if not root then continue end

			local dist = (root.Position - hrp.Position).Magnitude
			nearest = math.min(nearest, dist)

			if dist > CONFIG.RespawnDistance then
				relocateMonster(m)
			elseif dist < CONFIG.MonsterSightRange and hum then
				hum:MoveTo(hrp.Position)
			end

			if dist <= CONFIG.CatchDistance then
				triggerCatch()
				return
			end
		end

		-- Proximity heartbeat + static
		if Horror.heartbeat then
			local t = math.clamp(1 - (nearest / 60), 0, 1)
			Horror.heartbeat.Volume = t * 1.6
		end
		for _, m in ipairs(Horror.monsters) do
			local s = m:GetAttribute("StaticSound")
			if s and s.Parent then
				local root = m.PrimaryPart or m:FindFirstChild("HumanoidRootPart")
				if root then
					local d = (root.Position - hrp.Position).Magnitude
					s.Volume = math.clamp(1 - (d / 45), 0, 1) * 1.8
				end
			end
		end

		-- Key pickup
		if key and key.Parent then
			if (key.Position - hrp.Position).Magnitude <= 5 then
				local chime = newSound(CONFIG.Sounds.Chime, 2, false, SoundService)
				chime:Play()
				stopHorror(true)
			end
		end
	end)

	-- Random flicker events
	task.spawn(function()
		while Horror.running do
			task.wait(CONFIG.FlickerMin + math.random() * (CONFIG.FlickerMax - CONFIG.FlickerMin))
			if not Horror.running then break end
			local original = Lighting.Brightness
			for _ = 1, math.random(3, 7) do
				Lighting.Brightness = math.random() > 0.5 and 0 or original
				task.wait(math.random(4, 12) / 100)
			end
			Lighting.Brightness = original
		end
	end)

	-- Random scare events
	task.spawn(function()
		while Horror.running do
			task.wait(CONFIG.ScareMin + math.random() * (CONFIG.ScareMax - CONFIG.ScareMin))
			if not Horror.running then break end
			local fn = SCARE_EVENTS[math.random(1, #SCARE_EVENTS)]
			pcall(fn)
		end
	end)

	-- If the player respawns, hand them a new flashlight
	LP.CharacterAdded:Connect(function()
		if not Horror.running then return end
		task.wait(1)
		giveFlashlight()
	end)
end

start()
