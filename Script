--========================  UTILITIES  ================================
local function newSound(id, volume, looped, parent)
	local s = Instance.new("Sound")
	s.SoundId = id
	s.Volume  = volume or 1
	s.Looped  = looped or false
	s.Parent  = parent or SoundService
	return track(s)
end

local function findGround(position, ignore)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignore or {}
	local hit = Workspace:Raycast(position + Vector3.new(0, 120, 0), Vector3.new(0, -600, 0), params)
	return hit and hit.Position or nil
end

local function randomAroundPlayer(minDist, maxDist)
	local char = LP.Character
	local hrp  = char and char:FindFirstChild("HumanoidRootPart")
	if not hrp then return nil end
	local angle = math.random() * math.pi * 2
	local dist  = minDist + math.random() * (maxDist - minDist)
	return hrp.Position + Vector3.new(math.cos(angle) * dist, 0, math.sin(angle) * dist)
end

--======================  1. DARKNESS / ATMOSPHERE  ===================
local function applyAtmosphere()
	-- Back up whatever was there so we can restore it
	for _, name in ipairs({ "HorrorColor", "HorrorBloom", "HorrorBlur", "HorrorAtmosphere" }) do
		local existing = Lighting:FindFirstChild(name)
		if existing then existing:Destroy() end
	end

	Horror.lightingBackup = {
		ClockTime  = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		FogEnd     = Lighting.FogEnd,
		FogStart   = Lighting.FogStart,
		Ambient    = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}

	Lighting.ClockTime      = 0
	Lighting.Brightness     = 0.05
	Lighting.FogEnd         = 55
	Lighting.FogStart       = 8
	Lighting.FogColor       = Color3.fromRGB(6, 6, 8)
	Lighting.Ambient        = Color3.fromRGB(12, 12, 14)
	Lighting.OutdoorAmbient = Color3.fromRGB(10, 10, 12)
	Lighting.GlobalShadows  = true

	local cc = Instance.new("ColorCorrectionEffect")
	cc.Name       = "HorrorColor"
	cc.Brightness = -0.32
	cc.Contrast   = 0.25
	cc.Saturation = -0.55
	cc.TintColor  = Color3.fromRGB(190, 195, 210)
	cc.Parent     = Lighting
	track(cc)

	local bloom = Instance.new("BloomEffect")
	bloom.Name      = "HorrorBloom"
	bloom.Intensity = 0.7
	bloom.Size      = 18
	bloom.Threshold = 1.4
	bloom.Parent    = Lighting
	track(bloom)

	local blur = Instance.new("BlurEffect")
	blur.Name    = "HorrorBlur"
	blur.Size    = 4
	blur.Parent  = Lighting
	track(blur)

	local atmo = Instance.new("Atmosphere")
	atmo.Name        = "HorrorAtmosphere"
	atmo.Density     = 0.42
	atmo.Haze        = 2.5
	atmo.Glare       = 0
	atmo.Color       = Color3.fromRGB(20, 20, 24)
	atmo.Decay       = Color3.fromRGB(10, 10, 12)
	atmo.Parent      = Lighting
	track(atmo)
end

